{
  "name": "copilot-cowork-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise-ready starter template for Microsoft 365 Copilot Cowork Plugins with MCP server support.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:mcp-server": "pnpm --filter @copilot-cowork-plugin/mcp-server dev",
    "build": "pnpm --filter @copilot-cowork-plugin/mcp-server build",
    "test": "pnpm --filter @copilot-cowork-plugin/mcp-server test",
    "lint": "echo \"Configure ESLint and Prettier in your editor or package.json scripts.\"",
    "format": "echo \"Configure Prettier in your editor or package.json scripts.\"",
    "validate-manifest": "pnpm tsx ./scripts/validate-manifest.ts",
    "package-plugin": "pnpm tsx ./scripts/package-plugin.ts"
  },
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.0.3",
    "@types/express": "^4.17.20",
    "@types/node": "^20.14.2",
    "archiver": "^8.0.0",
    "dotenv": "^16.3.1",
    "prettier": "^3.0.0",
    "tsup": "^8.5.1",
    "tsx": "^3.12.7",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7",
    "zod": "^3.23.2"
  }
}
